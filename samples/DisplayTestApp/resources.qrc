<!DOCTYPE RCC>
<RCC version="1.0">
    <qresource prefix="/">
        <file alias="freecad.qss">freecad.qss</file>
    </qresource>
    <qresource prefix="/fonts">
        <!-- itwinjs-core display-test-app 的图标字体（MIT）——Surface 页 5 项功能的
             原始图标（ToolBar.ts:18 fontFamily "Display-Test-App-Icons"）。
             Ported from: itwinjs-core test-apps/display-test-app/public/Fonts/ -->
        <file alias="Display-Test-App-Icons.ttf">fonts/Display-Test-App-Icons.ttf</file>
    </qresource>
    <qresource prefix="/icons">
        <!-- DTA 工具栏图标（.static-assets 的 SVG——Viewer.ts createImageButton 引用）。
             Ported from: itwinjs-core test-apps/display-test-app/.static-assets/ -->
