<!DOCTYPE RCC>
<RCC version="1.0">
    <qresource prefix="/">
        <file alias="freecad.qss">freecad.qss</file>
    </qresource>
    <qresource prefix="/fonts">
        <!-- itwinjs-core display-test-app 的图标字体（MIT）——Surface 页 5 项功能的
             原始图标（ToolBar.ts:18 fontFamily "Display-Test-App-Icons"）。
             Ported from: itwinjs-core test-apps/display-test-app/public/Fonts/ -->
        <file alias="Display-Test-App-Icons.ttf">fonts/Display-Test-App-Icons.ttf</file>
    </qresource>
    <qresource prefix="/icons">
        <!-- DTA 工具栏图标（.static-assets 的 SVG——Viewer.ts createImageButton 引用）。
             Ported from: itwinjs-core test-apps/display-test-app/.static-assets/ -->
        <file alias="dta/zoom.svg">icons/dta/zoom.svg</file>
        <file alias="dta/fit-to-view.svg">icons/dta/fit-to-view.svg</file>
        <file alias="dta/window-area.svg">icons/dta/window-area.svg</file>
        <file alias="dta/rotate-left.svg">icons/dta/rotate-left.svg</file>
        <file alias="dta/walk.svg">icons/dta/walk.svg</file>

        <!-- 宿主命令图标（Command*.cpp 的 sPixmap 动态解析：QIcon(":/icons/"+sPixmap)） -->
        <file alias="document-new.svg">icons/document-new.svg</file>
        <file alias="Std_Import.svg">icons/Std_Import.svg</file>
        <file alias="application-exit.svg">icons/application-exit.svg</file>
        <file alias="window-new.svg">icons/window-new.svg</file>
        <file alias="view-axonometric.svg">icons/view-axonometric.svg</file>
        <file alias="view-isometric.svg">icons/view-isometric.svg</file>
        <file alias="view-perspective.svg">icons/view-perspective.svg</file>
        <file alias="view-front.svg">icons/view-front.svg</file>
        <file alias="view-top.svg">icons/view-top.svg</file>
        <file alias="view-right.svg">icons/view-right.svg</file>
        <file alias="view-rear.svg">icons/view-rear.svg</file>
        <file alias="view-bottom.svg">icons/view-bottom.svg</file>
        <file alias="view-left.svg">icons/view-left.svg</file>
        <file alias="view-fullscreen.svg">icons/view-fullscreen.svg</file>
        <file alias="zoom-all.svg">icons/zoom-all.svg</file>

        <!-- freecad.qss 视觉基线图标（url(:/icons/images_classic/…)——MDIChromeTest 像素断言依赖） -->
        <file alias="images_classic/close-black.svg">icons/images_classic/close-black.svg</file>
        <file alias="images_classic/close-red.svg">icons/images_classic/close-red.svg</file>
        <file alias="images_classic/close-darkred.svg">icons/images_classic/close-darkred.svg</file>
        <file alias="images_classic/close-lightgray.svg">icons/images_classic/close-lightgray.svg</file>
        <file alias="images_classic/undock-black.svg">icons/images_classic/undock-black.svg</file>
        <file alias="images_classic/undock-blue.svg">icons/images_classic/undock-blue.svg</file>
        <file alias="images_classic/overlay-lightgray.svg">icons/images_classic/overlay-lightgray.svg</file>
        <file alias="images_classic/overlay-black.svg">icons/images_classic/overlay-black.svg</file>
        <file alias="images_classic/float-lightgray.svg">icons/images_classic/float-lightgray.svg</file>
        <file alias="images_classic/float-black.svg">icons/images_classic/float-black.svg</file>
        <file alias="images_classic/sizegrip-lightgray.svg">icons/images_classic/sizegrip-lightgray.svg</file>
        <file alias="images_classic/hmovetoolbar-lightgray.svg">icons/images_classic/hmovetoolbar-lightgray.svg</file>
        <file alias="images_classic/hmovetoolbar-black.svg">icons/images_classic/hmovetoolbar-black.svg</file>
        <file alias="images_classic/vmovetoolbar-lightgray.svg">icons/images_classic/vmovetoolbar-lightgray.svg</file>
        <file alias="images_classic/vmovetoolbar-black.svg">icons/images_classic/vmovetoolbar-black.svg</file>
        <file alias="images_classic/splitter_vertical-lightgray.svg">icons/images_classic/splitter_vertical-lightgray.svg</file>
        <file alias="images_classic/splitter_horizontal-lightgray.svg">icons/images_classic/splitter_horizontal-lightgray.svg</file>
        <file alias="images_classic/arrow-down-lightgray.svg">icons/images_classic/arrow-down-lightgray.svg</file>
        <file alias="images_classic/arrow-down-black.svg">icons/images_classic/arrow-down-black.svg</file>
        <file alias="images_classic/arrow-up-lightgray.svg">icons/images_classic/arrow-up-lightgray.svg</file>
        <file alias="images_classic/arrow-up-black.svg">icons/images_classic/arrow-up-black.svg</file>
        <file alias="images_classic/arrow-left-lightgray.svg">icons/images_classic/arrow-left-lightgray.svg</file>
        <file alias="images_classic/arrow-left-black.svg">icons/images_classic/arrow-left-black.svg</file>
        <file alias="images_classic/arrow-left-darkgray.svg">icons/images_classic/arrow-left-darkgray.svg</file>
        <file alias="images_classic/arrow-right-lightgray.svg">icons/images_classic/arrow-right-lightgray.svg</file>
        <file alias="images_classic/arrow-right-black.svg">icons/images_classic/arrow-right-black.svg</file>
        <file alias="images_classic/arrow-right-darkgray.svg">icons/images_classic/arrow-right-darkgray.svg</file>
        <file alias="images_classic/check-mark-black.svg">icons/images_classic/check-mark-black.svg</file>
        <file alias="images_classic/check-mark-lightgray.svg">icons/images_classic/check-mark-lightgray.svg</file>
        <file alias="images_classic/checkbox-checked-black.svg">icons/images_classic/checkbox-checked-black.svg</file>
        <file alias="images_classic/checkbox-checked-lightgray.svg">icons/images_classic/checkbox-checked-lightgray.svg</file>
        <file alias="images_classic/checkbox-empty-black.svg">icons/images_classic/checkbox-empty-black.svg</file>
        <file alias="images_classic/checkbox-empty-lightgray.svg">icons/images_classic/checkbox-empty-lightgray.svg</file>
        <file alias="images_classic/checkbox-indeterminate-black.svg">icons/images_classic/checkbox-indeterminate-black.svg</file>
        <file alias="images_classic/radio-checked-black.svg">icons/images_classic/radio-checked-black.svg</file>
        <file alias="images_classic/radio-checked-lightgray.svg">icons/images_classic/radio-checked-lightgray.svg</file>
        <file alias="images_classic/radio-unchecked-black.svg">icons/images_classic/radio-unchecked-black.svg</file>
        <file alias="images_classic/radio-unchecked-lightgray.svg">icons/images_classic/radio-unchecked-lightgray.svg</file>
        <file alias="images_classic/radio-mark-black.svg">icons/images_classic/radio-mark-black.svg</file>
        <file alias="images_classic/radio-mark-lightgray.svg">icons/images_classic/radio-mark-lightgray.svg</file>
        <file alias="images_classic/indeterminate-mark-black.svg">icons/images_classic/indeterminate-mark-black.svg</file>
        <file alias="images_classic/indeterminate-mark-lightgray.svg">icons/images_classic/indeterminate-mark-lightgray.svg</file>
        <file alias="images_classic/more-hack.svg">icons/images_classic/more-hack.svg</file>

        <!-- MDI 视图窗口装饰（MDIView/MDI 子窗 chrome） -->
        <file alias="overlay/close.svg">icons/overlay/close.svg</file>
        <file alias="overlay/float.svg">icons/overlay/float.svg</file>
        <file alias="overlay/overlay.svg">icons/overlay/overlay.svg</file>

        <!-- Mouse navigation 图标（View3DInventor 右上角导航球——NavigationBlender 风格） -->
        <file alias="NavigationBlender_light.svg">icons/NavigationBlender_light.svg</file>

        <!-- User input icons (for InputHintWidget key rendering) -->
        <file alias="user-input/mouse-left.svg">icons/user-input/mouse-left.svg</file>
        <file alias="user-input/mouse-right.svg">icons/user-input/mouse-right.svg</file>
        <file alias="user-input/mouse-move.svg">icons/user-input/mouse-move.svg</file>
        <file alias="user-input/mouse-middle.svg">icons/user-input/mouse-middle.svg</file>
        <file alias="user-input/mouse-scroll.svg">icons/user-input/mouse-scroll.svg</file>
        <file alias="user-input/mouse-scroll-up.svg">icons/user-input/mouse-scroll-up.svg</file>
        <file alias="user-input/mouse-scroll-down.svg">icons/user-input/mouse-scroll-down.svg</file>
    </qresource>
</RCC>
<!-- M-O(1) D1（2026-10-01）：FreeCAD 死图标清理——qrc 从 161 icon 裁到 74（引用面三类合并：
     src 字面 :/icons/、freecad.qss url()、sPixmap 动态解析；delete 清单 87 项全部零引用，
     对应 icons/ 磁盘文件同步删除）。删除项=已删 FreeCAD 命令域（Edit/Macro/Help/Tools/
     Structure/可见性组/DrawStyle/打印族）与孤儿图标的图标残余。 -->
